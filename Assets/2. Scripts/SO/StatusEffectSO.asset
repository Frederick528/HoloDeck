  m_Script: {fileID: 11500000, guid: f2b03bfd47d605c4ea9b6836d5764f10, type: 3}
  m_Name: StatusEffectSO
  m_EditorClassIdentifier: 
  SESprites: []
  SEDatas:
  - SE: 0
    SET: 0
    Descript: "\uB9D9\uC18C\uC0AC. \uC774\uAC74 \uC5B4\uB5A4 \uBC84\uD504\uC9C0\uC694?"
    Sprite: {fileID: 0}
  - SE: 1
    SET: 0
    Descript: "\uD574\uB2F9 \uC801\uC740 {n}\uB9CC\uD07C\uC758 \uACF5\uACA9\uC744
      \uC900\uBE44 \uC911\uC785\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 2
    SET: 0
    Descript: "\uD574\uB2F9 \uC801\uC740 {n}\uB9CC\uD07C\uC758 \uBC29\uC5B4\uB97C
      \uC900\uBE44 \uC911\uC785\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 3
    SET: 0
    Descript: "\uD574\uB2F9 \uC801\uC740 {n}\uB9CC\uD07C\uC758 \uD68C\uBCF5\uC744
      \uC900\uBE44 \uC911\uC785\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 4
    SET: 0
    Descript: "\uACF5\uACA9\uB825\uC774 {n}\uB9CC\uD07C \uC99D\uAC00\uD588\uC2B5\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 5
    SET: 0
    Descript: "\uBC29\uC5B4\uB825\uC774 {n}\uB9CC\uD07C \uC99D\uAC00\uD588\uC2B5\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 6
    SET: 0
    Descript: "\uD68C\uBCF5\uB825\uC774 {n}\uB9CC\uD07C \uC99D\uAC00\uD588\uC2B5\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 7
    SET: 0
    Descript: "\uD53C\uD574\uB97C \uBC1B\uC744 \uB54C, 50%\uC758 \uB370\uBBF8\uC9C0\uB97C
      \uCD94\uAC00\uB85C \uBC1B\uC2B5\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 8
    SET: 0
    Descript: "\uD53C\uD574\uB97C \uC904 \uB54C, 25%\uB9CC\uD07C \uB370\uBBF8\uC9C0\uAC00
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 9
    SET: 0
    Descript: "\uC9C1\uC811 \uD53C\uD574\uB97C \uBC1B\uC740 \uD6C4 \uC0B4\uC544\uC788\uB2E4\uBA74,
      {n}\uC758 \uD53C\uD574\uB97C \uBC18\uC0AC\uD569\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 10
    SET: 0
    Descript: "\uC9C1\uC811 \uD53C\uD574\uB97C \uBC1B\uAE30 \uC804, {n}\uB9CC\uD07C
      \uC274\uB4DC\uB97C \uC5BB\uC2B5\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 11
    SET: 0
    Descript: "\uCE58\uBA85\uC801\uC778 \uD53C\uD574\uB97C \uBC1B\uC558\uC744 \uACBD\uC6B0,
      \uCD5C\uB300 \uCCB4\uB825\uC758 50%\uB9CC\uD07C \uD68C\uBCF5\uD569\uB2C8\uB2E4.
      ({n}\uBC88 \uC0AC\uC6A9 \uAC00\uB2A5\uD569\uB2C8\uB2E4.)"
    Sprite: {fileID: 0}
  - SE: 12
    SET: 0
    Descript: "\uC5BB\uB294 \uCF54\uC778 \uD68D\uB4DD\uB7C9\uC774 {n}%p\uB9CC\uD07C
      \uC99D\uAC00\uD569\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 13
    SET: 0
    Descript: "\uCE58\uBA85\uD0C0 \uD655\uB960\uC774 {n}%p\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 14
    SET: 0
    Descript: "\uCE58\uBA85\uD0C0 \uB370\uBBF8\uC9C0\uAC00 {n}%p\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 15
    SET: 0
    Descript: "\uCD5C\uB300 \uCCB4\uB825\uC774 {n}\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 16
    SET: 0
    Descript: "\uACF5\uACA9\uD560 \uB54C\uB9C8\uB2E4 {n}\uCF54\uC778\uC744 \uD6D4\uCE69\uB2C8\uB2E4.
      \uD574\uB2F9 \uACE8\uB4DC\uB294 \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uB3CC\uB824
      \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 16
    SET: 0
    Descript: 
    Sprite: {fileID: 0}
  - SE: 18
    SET: 0
    Descript: "\uB2E4\uC74C \uACF5\uACA9\uC774 {CriticalDamage}%\uB9CC\uD07C \uCD94\uAC00
      \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 19
    SET: 0
    Descript: "{n}\uD68C\uB3D9\uC548 \uD53C\uD574 \uBA74\uC5ED \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 20
    SET: 0
    Descript: "\uB9C9\uD788\uC9C0 \uC54A\uB294 \uC9C1\uC811 \uD53C\uD574\uB97C \uC785\uD790
      \uB54C\uB9C8\uB2E4, \uCCB4\uB825\uC744 \uB370\uBBF8\uC9C0\uC758 20%\uB9CC\uD07C
      \uD68C\uBCF5\uD569\uB2C8\uB2E4. \uC774\uB294 \uBC18\uC0AC\uBCF4\uB2E4 \uBA3C\uC800
      \uC801\uC6A9\uB429\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 21
    SET: 0
    Descript: "\uB370\uBBF8\uC9C0\uB97C \uBC1B\uC744 \uB54C\uB9C8\uB2E4 \uC774\uBC88
      \uC804\uD22C\uB3D9\uC548 \uACF5\uACA9\uB825\uC774 {n}\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4."
    Sprite: {fileID: 0}
  - SE: 22
    SET: 0
    Descript: "\uB2E4\uC74C \uACF5\uACA9\uC73C\uB85C \uCE58\uBA85\uD0C0 \uC5D0\uB108\uC9C0\uB97C
      {n}\uB9CC\uD07C \uC5BB\uC744 \uC608\uC815\uC785\uB2C8\uB2E4."
    Sprite: {fileID: 0}
